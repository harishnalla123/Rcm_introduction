
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RCM Wonder World</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="style.css">

</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand">RCM Wonder World</a>
  </div>
</nav>

<!-- Hero Section -->
<div class="hero text-center text-Red">
    <h1>Welcome to RCM World</h1>
    <p>Right Concept Marketing</p>
</div>

<!-- About -->
<div class="container mt-5">
    <h2>About RCM</h2>
    <p>
        RCM is one of India's leading direct-selling companies founded by T.C. Chhabra.
        It provides 450+ quality products and empowers people financially.
    </p>
</div>

<!-- Image Section -->
<div class="container mt-5 text-center">
    <img src="images/rcm.jpg" class="img-fluid rounded shadow">
</div>

<!-- Contact Form -->
<div class="container mt-5">
    <h2>Join Us</h2>

    <form id="form">
        <input type="text" name="name" class="form-control mb-3" placeholder="Enter Name" required>
        <input type="email" name="email" class="form-control mb-3" placeholder="Enter Email" required>
        <button class="btn btn-success">Submit</button>
    </form>

    <p id="response" class="mt-3 text-success"></p>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center p-3 mt-5">
    <p>JAI RCM | Designed by Harish</p>
</footer>

<script src="script.js"></script>

</body>
</html>
